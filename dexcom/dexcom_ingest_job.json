{
  "name": "Dexcom CGM ingest",
  "schedule": {
    "quartz_cron_expression": "0 0/30 * * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "ingest_egv",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<you>/dexcom_ingest_notebook",
        "base_parameters": { "environment": "sandbox", "secret_scope": "dexcom" }
      }
    }
  ]
}
