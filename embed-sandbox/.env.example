# Sigma embed credentials (Administration > Developer Access > Embed secrets).
# These stay on the server and are never sent to the browser.
SIGMA_CLIENT_ID=
SIGMA_EMBED_SECRET=

# Lifetime of a signed embed URL in seconds (Sigma allows up to 3600).
SESSION_SECONDS=600

# API port. The Vite dev server proxies /api to this port.
PORT=3001
